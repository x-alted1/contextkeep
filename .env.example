# ---- contextkeep configuration ----
# Copy to .env and edit. No cloud API keys are needed for the default,
# fully-local setup.

# Who this memory belongs to (namespace). Use one id per person.
CONTEXT_USER_ID=me

# Path to your Master Context File INSIDE the container (mounted from ./context).
CONTEXT_FILE=/context/context.md

# Runtime inbox — appended by add_memory; merge into context.md periodically.
CONTEXT_INBOX=/context/inbox.md

# ---- Models (run locally in the Ollama container) ----
# Smaller = faster + less RAM. 8B needs ~6-8GB; try llama3.2:3b on tiny servers.
MEM0_LLM_MODEL=llama3.1:8b
MEM0_EMBED_MODEL=nomic-embed-text
# Embedding dimensions MUST match the embed model. nomic-embed-text = 768.
# Validated at startup against a live Ollama embedding probe.
MEM0_EMBED_DIMS=768

# ---- Service wiring (defaults work with the provided compose) ----
OLLAMA_BASE_URL=http://ollama:11434
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=contextkeep

# ---- MCP server ----
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_TRANSPORT=streamable-http

# Set to 1 to allow delete_all_memories without confirm=True (not recommended).
# CONFIRM_DELETE=0

# ---- OPTIONAL: graph memory via Neo4j (compose --profile graph) ----
# NEO4J_URL=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me
